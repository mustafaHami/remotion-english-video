  "lessonData": {
    "dialogue": [
      {
        "en": "Can you do me a favor?",
        "fr": "Tu peux me rendre un service ?"
      },
      {
        "en": "Sure. What do you need?",
        "fr": "Bien sûr. De quoi as-tu besoin ?"
      },
      {
        "en": "Could you check this email?",
        "fr": "Tu pourrais vérifier cet e-mail ?"
      },
      {
        "en": "Of course. When do you need it?",
        "fr": "Bien sûr. Pour quand ?"
      },
      {
        "en": "Before lunch, if possible.",
        "fr": "Avant le déjeuner, si possible."
      },
      {
        "en": "No problem. I’ll read it now.",
        "fr": "Pas de souci. Je vais le lire."
      },
      {
        "en": "Thanks. That really helps.",
        "fr": "Merci. Ça m’aide beaucoup."
      },
      {
        "en": "You’re welcome.",
        "fr": "Avec plaisir."
      }
    ]
  },
