[Unit]
Description=Englizy Excel tracking and authorized retention
After=englizy-bridge.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/srv/englizy-repository
ExecStart=/usr/bin/env /srv/englizy-repository/.venv/bin/python /srv/englizy-repository/scripts/planning/maintain-tracking.py --config /etc/englizy/tracking.json
UMask=0077
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
BindReadOnlyPaths=/root/projects/remotion-english-video:/srv/englizy-repository
BindPaths=/root/projects/remotion-english-video/planning:/srv/englizy-repository/planning
BindPaths=/root/projects/remotion-english-video/output/options:/srv/englizy-repository/output/options
ReadWritePaths=/var/lib/englizy-bridge /var/lib/englizy-media /var/lib/englizy-tracking
ReadWritePaths=-/var/lib/englizy-public-media
InaccessiblePaths=/var/lib/englizy/secrets /var/lib/englizy-worker/.codex
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SETUID CAP_CHOWN CAP_FOWNER
