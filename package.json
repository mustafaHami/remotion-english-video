{
  "name": "remotion-english-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts --port=3000",
    "browser": "remotion browser ensure",
    "render": "node scripts/render.cjs",
    "render:all": "node scripts/render.cjs --all",
    "preview:all": "node scripts/render.cjs --all --stills-only",
    "inspect:all": "python scripts/verify-video.py --all",
    "prepare:audio": "python scripts/prepare-audio.py --all",
    "check": "tsc --noEmit",
    "verify": "node scripts/check-project.cjs && node scripts/sync-skills.cjs --check",
    "test": "node --test tests/*.test.cjs",
    "skills:sync": "node scripts/sync-skills.cjs",
    "planning:import": "python scripts/planning/import-calendar.py --write",
    "daily": "node scripts/daily.cjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.3.1",
    "react-dom": "19.2.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
